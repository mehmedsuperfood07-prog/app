// Cloudflare Workers hosting for the order app (OpenNext, open-next.config.ts). Deploy with
// `npm run cf -- deploy-test` (the test copy, mehmed-order-test, on the ERP's dev database)
// or `npm run cf -- deploy-live --yes-live` (mehmed-order, the live database), from
// scripts/cloudflare.mjs, which signs in to Mehmed's Cloudflare account.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mehmed-order-test",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
